DATABASE_URL=<Neon URL, with ?sslmode=require>
LOG_FORMAT=json

# Aiven Kafka
KAFKA_BROKERS=YOUR_AIVEN_KAFKA_BOOTSTRAP_HOST:PORT
KAFKA_SECURITY_PROTOCOL=SASL_SSL
KAFKA_SASL_MECHANISM=SCRAM-SHA-256
KAFKA_SASL_USERNAME=YOUR_AIVEN_USERNAME
KAFKA_SASL_PASSWORD=CHANGE_ME
KAFKA_TOPIC=telemetry.ingested
KAFKA_DLQ_TOPIC=telemetry.ingested.dlq
KAFKA_ALLOW_AUTO_TOPIC=false
KAFKA_PRODUCE_TIMEOUT=10s
KAFKA_SSL_CA_PEM=YOUR_AIVEN_CA_PEM_WITH_ESCAPED_NEWLINES

# HiveMQ Cloud. HiveMQ Cloud usually uses TLS MQTT on port 8883.
MQTT_BROKER=ssl://YOUR_HIVEMQ_HOST:8883
MQTT_TOPIC_FILTER=africa-west/+/+/+/telemetry
MQTT_QOS=1
MQTT_USERNAME=YOUR_HIVEMQ_USERNAME
MQTT_PASSWORD=CHANGE_ME

# Always-on staging demo size and cadence.
SIMULATOR_SITES=20
SIMULATOR_METERS_PER_SITE=10
SIMULATOR_INCLUDE_SITE_KIT=true
SIMULATOR_INTERVAL=5s
SIMULATOR_DURATION=0
SIMULATOR_LOG_PUBLISHES=false

# Topic identity. Keep this aligned with ingestion-go MQTT_TOPIC_FILTER.
MQTT_REGION=africa-west
MQTT_SITE_PREFIX=ng-demo

# Topic names
TELEMETRY_TOPIC=telemetry.ingested
TELEMETRY_DLQ_TOPIC=telemetry.ingested.dlq
TELEMETRY_GROUP_ID=engine-rust-staging
ALERT_OPENED_TOPIC=alert.opened
ALERT_RESOLVED_TOPIC=alert.resolved

# Comma-separated Actor IDs allowed to resolve alerts while staging auth is thin.
ALERT_RESOLVE_ACTORS=actor-0101

INGESTION_QUEUE_SIZE=1000
INGESTION_WORKERS=4
INGESTION_SHUTDOWN_TIMEOUT=10s
INGESTION_LOG_EVERY_N=25
